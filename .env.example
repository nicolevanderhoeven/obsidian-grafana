# Only needed when running `docker compose` directly. setup.sh reads the same
# two values from config.yaml (vault_path, grafana_password) and exports them.
VAULT_PATH="/path/to/your/obsidian/vault"
GRAFANA_PASSWORD="choose-a-strong-password"

# Optional: forward the same telemetry to Grafana Cloud (off by default).
# Enable with: docker compose --profile cloud up -d   (see README, "Grafana Cloud forwarding").
# Find the URLs and user IDs under Grafana Cloud > your stack > Details (Prometheus / Loki).
# GRAFANA_CLOUD_PROMETHEUS_URL="https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push"
# GRAFANA_CLOUD_PROMETHEUS_USER="123456"
# GRAFANA_CLOUD_LOKI_URL="https://logs-prod-XXX.grafana.net/loki/api/v1/push"
# GRAFANA_CLOUD_LOKI_USER="123456"
# One access policy token with metrics:write and logs:write scopes (never commit it)
# GRAFANA_CLOUD_TOKEN="glc_..."
