# Obsidian to Grafana Configuration
# Copy this file to config.yaml and update the values for your setup

vault_path: "/path/to/your/obsidian/vault"  # Update this to your actual vault path
output_file: "./logs/obsidian_logs.json"
log_level: "INFO"  # Options: DEBUG, INFO, WARNING, ERROR
metrics_port: 8080
start_metrics_server: false  # Set to true to enable metrics collection
# Low-series metrics tuning (nothing is exposed per note)
top_linked_notes: 50  # most-linked notes exposed as obsidian_top_linked_note_backlinks (0 disables)
max_folders: 50       # top-level folders exposed individually; the rest are folded into "(other)"
grafana_password: "your_grafana_password_here"  # Replace with your actual Grafana password

# Files to exclude from parsing (matched against note filename without extension)
exclude_files:
  - "Changelog"

# Vault index for OpenClaw integration (keep outside the vault to avoid Obsidian indexing it)
index_output_path: "/path/to/openclaw-index"
