# Logs directory (contents ignored; logs/.gitkeep keeps the folder so Docker doesn't create it as root)
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.pytest_cache/
.ruff_cache/

# Local assistant settings
.claude/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local Grafana plugin files and ZIPs (plugins are installed via GF_INSTALL_PLUGINS)
grafana/plugins/
*.zip

# Backups written by scripts/legacy/backfill_event_type.py
*.pre_backfill

# Environment and configuration files with sensitive data
.env
.env.*
!.env.example
config.yaml
