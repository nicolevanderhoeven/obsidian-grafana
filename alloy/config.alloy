// Alloy configuration for Obsidian note monitoring
// This configuration reads JSON log entries and forwards them to Loki

// Discover the log files. local.file_match keeps re-checking the paths, so files
// that don't exist yet when Alloy starts (first run, before the parser has run)
// are picked up as soon as they appear. (Static targets in loki.source.file are
// skipped permanently if the file is missing at startup.)
local.file_match "obsidian_logs" {
  path_targets = [
    {
      __path__ = "/logs/obsidian_logs.json",
      job      = "obsidian-parser",
    },
    {
      __path__ = "/logs/obsidian_parser.log",
      job      = "obsidian-cron",
    },
  ]
}

// Read the files and forward each line for processing
loki.source.file "obsidian_logs" {
  targets    = local.file_match.obsidian_logs.targets
  forward_to = [loki.process.obsidian_logs.receiver]
}

// Process the log entries to extract labels and format for Loki
loki.process "obsidian_logs" {
  forward_to = [loki.write.loki.receiver]

  // obsidian_parser.log mixes the parser's plain-text stdout/stderr (deprecation warnings,
  // INFO lines) with the JSON cron heartbeat written by scripts/cron-parse.sh. Keep only
  // JSON lines (the heartbeat); drop the plain text, which has no event timestamp and would
  // otherwise be stored with ingestion time. This stage must stay first, before the labels
  // stage below can overwrite `job`.
  stage.match {
    selector            = "{job=\"obsidian-cron\"} !~ \"^\\\\{\""
    action              = "drop"
    drop_counter_reason = "non_json_parser_log_line"
  }

  // Try to parse as JSON first (for obsidian_logs.json). Plain-text lines (the cron
  // heartbeat log) simply produce no extracted values. The log line itself is stored
  // unchanged: the dashboards parse the full entry (`| json | line_format "{{.line}}" | json`).
  stage.json {
    expressions = {
      timestamp = "timestamp",
      vault = "labels.vault",
      job = "labels.job",
      tags = "labels.tags",
      event_type = "labels.event_type",
      frontmatter_status = "labels.frontmatter_status",
      frontmatter_category = "labels.frontmatter_category",
      frontmatter_priority = "labels.frontmatter_priority",
      frontmatter_type = "labels.frontmatter_type",
    }
  }

  // Set the timestamp from the JSON (only if JSON parsing succeeded)
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }

  // Set labels for Loki
  stage.labels {
    values = {
      vault = "",
      job = "",
      tags = "",
      event_type = "",
      frontmatter_status = "",
      frontmatter_category = "",
      frontmatter_priority = "",
      frontmatter_type = "",
    }
  }
}

// Write to Loki
loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
